QWidget {
    background-color: #f0f0f0;
    color: #333;
}

QPushButton {
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 10px;
}

QPushButton:hover {
    background-color: #0056b3;
}

QLineEdit {
    border: 1px solid #ccc;
    border-radius: 5px;
    padding: 5px;
}

QLineEdit:focus {
    border: 1px solid #007bff;
}

QLabel {
    font-weight: bold;
}

QTableWidget {
    border: 1px solid #ccc;
    gridline-color: #ccc;
}

QTableWidget::item {
    padding: 5px;
}